<Window x:Class="MasterArbete.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WAV File Prototype" Height="320" Width="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- File picker row -->
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <Button x:Name="BrowseButton" Content="Open WAV file..." Width="140" Height="30"
                    Click="BrowseButton_Click"/>
            <TextBlock x:Name="FilePathText" Text="No file selected"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Playback controls -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,16,0,0">
            <Button x:Name="PlayButton" Content="Play" Width="80" Height="30"
                    Click="PlayButton_Click" IsEnabled="False"/>
            <Button x:Name="StopButton" Content="Stop" Width="80" Height="30"
                    Margin="8,0,0,0" Click="StopButton_Click" IsEnabled="False"/>
        </StackPanel>

        <!-- File info -->
        <Border Grid.Row="2" Margin="0,16,0,0" BorderBrush="#CCC" BorderThickness="1" Padding="12">
            <StackPanel>
                <TextBlock Text="File info" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock x:Name="FormatText" Text="Format: -"/>
                <TextBlock x:Name="SampleRateText" Text="Sample rate: -"/>
                <TextBlock x:Name="ChannelsText" Text="Channels: -"/>
                <TextBlock x:Name="BitDepthText" Text="Bit depth: -"/>
                <TextBlock x:Name="DurationText" Text="Duration: -"/>
            </StackPanel>
        </Border>

        <!-- Status / error line -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,16,0,0"
                   Foreground="Red" TextWrapping="Wrap" VerticalAlignment="Top"/>
    </Grid>
</Window>
