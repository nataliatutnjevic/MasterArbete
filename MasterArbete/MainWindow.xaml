<Window x:Class="MasterArbete.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MasterArbete"
        Title="WAV File Prototype" Height="860" Width="1200"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.6*" MinHeight="300"/>
        </Grid.RowDefinitions>

        <!-- File picker row -->
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <Button x:Name="BrowseButton" Content="Open WAV file..." Width="140" Height="30"
                    Click="BrowseButton_Click"/>
            <TextBlock x:Name="FilePathText" Text="No file selected"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Playback controls -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,16,0,0">
            <Button x:Name="PlayButton" Content="Play" Width="80" Height="30"
                    Click="PlayButton_Click" IsEnabled="False"/>
            <Button x:Name="PauseButton" Content="Pause" Width="80" Height="30"
                    Margin="8,0,0,0" Click="PauseButton_Click" IsEnabled="False"/>
            <Button x:Name="StopButton" Content="Stop" Width="80" Height="30"
                    Margin="8,0,0,0" Click="StopButton_Click" IsEnabled="False"/>
        </StackPanel>

        <!-- Waveform: takes all the space left over -->
        <Border Grid.Row="2" Margin="0,16,0,0" BorderBrush="#CCC" BorderThickness="1">
            <local:WaveformView x:Name="Waveform" MinHeight="160"/>
        </Border>

        <!-- Status / error line -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0"
                   Foreground="Red" TextWrapping="Wrap"/>

        <!-- Tabs: file info and Soundswell header, background noise, reverberation time -->
        <TabControl Grid.Row="4" Margin="0,8,0,0">
            <TabItem Header="File info">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="File info" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="FormatText" Text="Format: -"/>
                        <TextBlock x:Name="ByteOrderText" Text="Byte order: -"/>
                        <TextBlock x:Name="SampleRateText" Text="Sample rate: -"/>
                        <TextBlock x:Name="ChannelsText" Text="Channels: -"/>
                        <TextBlock x:Name="BitDepthText" Text="Bit depth: -"/>
                        <TextBlock x:Name="DurationText" Text="Duration: -"/>
                        <TextBlock x:Name="ChunksText" Text="Chunks: -" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="SwelText" Text="swel: -" TextWrapping="Wrap"/>
                    </StackPanel>

                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="Soundswell header (swel)" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBox x:Name="SwelFieldsText" FontFamily="Consolas" IsReadOnly="True"
                                 BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Visibility="Collapsed"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Background noise">
                <StackPanel Margin="12">
                    <TextBlock Text="Measure the background noise in a calibrated recording" FontWeight="Bold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="From" VerticalAlignment="Center"/>
                        <TextBox x:Name="NoiseFromBox" Width="60" Margin="6,0,0,0" IsEnabled="False"/>
                        <TextBlock Text="to" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <TextBox x:Name="NoiseToBox" Width="60" Margin="6,0,0,0" IsEnabled="False"/>
                        <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <Button x:Name="MeasureNoiseButton" Content="Measure" Width="76" Height="24"
                                Margin="10,0,0,0" Click="MeasureNoiseButton_Click" IsEnabled="False"/>
                    </StackPanel>
                    <!-- A read-only TextBox rather than a TextBlock, so the results can be copied -->
                    <TextBox x:Name="NoiseResultText" FontFamily="Consolas" IsReadOnly="True"
                             BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                             Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Reverberation time">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="From" VerticalAlignment="Center"/>
                        <TextBox x:Name="ReverbFromBox" Width="60" Margin="6,0,0,0" IsEnabled="False"/>
                        <TextBlock Text="to" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <TextBox x:Name="ReverbToBox" Width="60" Margin="6,0,0,0" IsEnabled="False"/>
                        <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <Button x:Name="AnalyseReverbButton" Content="Analyse" Width="76" Height="24"
                                Margin="10,0,0,0" Click="AnalyseReverbButton_Click" IsEnabled="False"/>
                        <CheckBox x:Name="TimeReversedBox" Content="Time-reversed band filters" IsChecked="True"
                                  VerticalAlignment="Center" Margin="16,0,0,0"
                                  ToolTip="Filter the octave bands backwards in time, so the filters' own ringing doesn't lengthen short decays"/>
                        <TextBlock x:Name="ReverbStatusText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#555"/>
                    </StackPanel>

                    <!-- The decay of the band selected in the table -->
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#CCC" BorderThickness="1">
                        <local:DecayCurveView x:Name="DecayCurve"/>
                    </Border>

                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" Width="480">
                        <TextBlock DockPanel.Dock="Top" Text="Click a row to see its decay." Margin="0,0,0,6"/>
                        <DataGrid x:Name="ReverbTable" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column" CanUserSortColumns="False"
                                  CanUserReorderColumns="False" GridLinesVisibility="Horizontal"
                                  SelectionChanged="ReverbTable_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Band" Binding="{Binding Band}" Width="80"/>
                                <DataGridTextColumn Header="EDT (s)" Binding="{Binding Edt}" Width="*"/>
                                <DataGridTextColumn Header="T20 (s)" Binding="{Binding T20}" Width="*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="T30 (s)" Binding="{Binding T30}" Width="*"/>
                                <DataGridTextColumn Header="Range (dB)" Binding="{Binding DynamicRange}" Width="1.3*"/>
                                <DataGridTextColumn Header="C (%)" Binding="{Binding Curvature}" Width="*"/>
                                <DataGridTextColumn Header="ξ (‰)" Binding="{Binding NonLinearity}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
